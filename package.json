{
  "name": "@sudobility/music_spatial_core",
  "version": "0.0.32",
  "description": "Platform-agnostic engine behind the Moosiac Spatial view: instrument geometry, scene composition, camera/listener math, movement, and map-overlay math shared by music_spatial and music_spatial_rn.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs",
    "generate:voices": "bun scripts/generate-voice-models.ts && prettier --write src/voice-models.generated.ts",
    "export:instruments": "bun scripts/export-instrument-models.ts",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "dependencies": {},
  "peerDependencies": {
    "@sudobility/music_types": "^0.13.65",
    "react": ">=18",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/music_types": "^0.13.65",
    "@testing-library/react": "~16.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "~0.186.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~17.13.0",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "rimraf": "~6.1.3",
    "three": "~0.186.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_spatial_core.git"
  },
  "license": "BUSL-1.1"
}
